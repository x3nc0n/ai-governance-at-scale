{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "13147296223311403736"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the shared foundation resources."
      }
    },
    "apimName": {
      "type": "string",
      "defaultValue": "[format('apim-aigov-{0}', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Name of the shared API Management instance."
      }
    },
    "apimSkuName": {
      "type": "string",
      "defaultValue": "Developer",
      "allowedValues": [
        "Developer",
        "StandardV2"
      ],
      "metadata": {
        "description": "API Management pricing tier. Developer is the default demo SKU; StandardV2 is the production upgrade path."
      }
    },
    "containerAppsEnvironmentName": {
      "type": "string",
      "defaultValue": "[format('cae-aigov-{0}', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Name of the shared Container Apps managed environment."
      }
    },
    "logAnalyticsName": {
      "type": "string",
      "defaultValue": "[format('log-aigov-{0}', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Name of the Log Analytics workspace."
      }
    },
    "appInsightsName": {
      "type": "string",
      "defaultValue": "[format('appi-aigov-{0}', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Name of the Application Insights resource."
      }
    },
    "keyVaultName": {
      "type": "string",
      "defaultValue": "[format('kv-{0}', take(replace(uniqueString(resourceGroup().id, subscription().subscriptionId), '-', ''), 16))]",
      "metadata": {
        "description": "Name of the Key Vault used for runtime secrets."
      }
    },
    "aiServicesName": {
      "type": "string",
      "defaultValue": "[format('ais-{0}', take(uniqueString(resourceGroup().id), 12))]",
      "metadata": {
        "description": "Name of the Azure AI Services account."
      }
    },
    "createFoundryProject": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Whether to create an Azure AI Foundry project under the shared AI Services account. Disabled by default to keep the foundation deployable on subscriptions that do not expose the full Foundry project path."
      }
    },
    "aiProjectName": {
      "type": "string",
      "defaultValue": "aigov-foundry-project",
      "metadata": {
        "description": "Name of the Azure AI Foundry project."
      }
    },
    "deployModel": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Whether to create a default model deployment for the shared AI Services account. Disabled by default to keep the foundation deployable on subscriptions that do not expose the required model deployment API path."
      }
    },
    "modelDeploymentName": {
      "type": "string",
      "defaultValue": "gpt-4.1-mini",
      "metadata": {
        "description": "Name of the default model deployment."
      }
    },
    "modelName": {
      "type": "string",
      "defaultValue": "gpt-4.1-mini",
      "metadata": {
        "description": "Name of the model to deploy."
      }
    },
    "modelVersion": {
      "type": "string",
      "defaultValue": "2025-04-14",
      "metadata": {
        "description": "Model version to deploy."
      }
    },
    "modelSkuCapacity": {
      "type": "int",
      "defaultValue": 10,
      "metadata": {
        "description": "Capacity for the default model deployment."
      }
    }
  },
  "variables": {
    "identityNames": [
      "id-scenario-01",
      "id-scenario-02",
      "id-scenario-03",
      "id-scenario-04"
    ]
  },
  "resources": [
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[parameters('containerAppsEnvironmentName')]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.Resources/deployments', 'monitoring'), '2025-04-01').outputs.workspaceCustomerId.value]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName')), '2022-10-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', 'monitoring')]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[parameters('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "accessPolicies": [],
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "enablePurgeProtection": true,
        "softDeleteRetentionInDays": 90,
        "createMode": "default",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2025-06-01",
      "name": "[parameters('aiServicesName')]",
      "location": "[parameters('location')]",
      "kind": "AIServices",
      "identity": {
        "type": "SystemAssigned"
      },
      "sku": {
        "name": "S0"
      },
      "properties": {
        "publicNetworkAccess": "Enabled",
        "customSubDomainName": "[toLower(parameters('aiServicesName'))]",
        "disableLocalAuth": false
      }
    },
    {
      "condition": "[parameters('createFoundryProject')]",
      "type": "Microsoft.CognitiveServices/accounts/projects",
      "apiVersion": "2025-06-01",
      "name": "[format('{0}/{1}', parameters('aiServicesName'), parameters('aiProjectName'))]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "[parameters('aiProjectName')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', parameters('aiServicesName'))]"
      ]
    },
    {
      "condition": "[parameters('deployModel')]",
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2025-06-01",
      "name": "[format('{0}/{1}', parameters('aiServicesName'), parameters('modelDeploymentName'))]",
      "sku": {
        "name": "Standard",
        "capacity": "[parameters('modelSkuCapacity')]",
        "tier": "Standard"
      },
      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "[parameters('modelName')]",
          "version": "[parameters('modelVersion')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', parameters('aiServicesName'))]"
      ]
    },
    {
      "type": "Microsoft.ApiManagement/service",
      "apiVersion": "2022-08-01",
      "name": "[parameters('apimName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('apimSkuName')]",
        "capacity": 1
      },
      "properties": {
        "publisherEmail": "admin@example.com",
        "publisherName": "AI Governance Demo",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "monitoring",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "logAnalyticsName": {
            "value": "[parameters('logAnalyticsName')]"
          },
          "appInsightsName": {
            "value": "[parameters('appInsightsName')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.44.1.10279",
              "templateHash": "2847612750916715292"
            }
          },
          "parameters": {
            "location": {
              "type": "string",
              "metadata": {
                "description": "Azure region for the monitoring resources."
              }
            },
            "logAnalyticsName": {
              "type": "string",
              "metadata": {
                "description": "Name of the Log Analytics workspace."
              }
            },
            "appInsightsName": {
              "type": "string",
              "metadata": {
                "description": "Name of the Application Insights resource."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.OperationalInsights/workspaces",
              "apiVersion": "2022-10-01",
              "name": "[parameters('logAnalyticsName')]",
              "location": "[parameters('location')]",
              "properties": {
                "sku": {
                  "name": "PerGB2018"
                },
                "retentionInDays": 30,
                "features": {
                  "enableLogAccessUsingOnlyResourcePermissions": true
                }
              }
            },
            {
              "type": "Microsoft.Insights/components",
              "apiVersion": "2020-02-02",
              "name": "[parameters('appInsightsName')]",
              "location": "[parameters('location')]",
              "kind": "web",
              "properties": {
                "Application_Type": "web",
                "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName'))]",
                "Flow_Type": "Bluefield",
                "Request_Source": "rest"
              },
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName'))]"
              ]
            }
          ],
          "outputs": {
            "workspaceId": {
              "type": "string",
              "value": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName'))]"
            },
            "workspaceName": {
              "type": "string",
              "value": "[parameters('logAnalyticsName')]"
            },
            "workspaceCustomerId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName')), '2022-10-01').customerId]"
            },
            "appInsightsConnectionString": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Insights/components', parameters('appInsightsName')), '2020-02-02').ConnectionString]"
            },
            "appInsightsName": {
              "type": "string",
              "value": "[parameters('appInsightsName')]"
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "scenario-identities",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "identityNames": {
            "value": "[variables('identityNames')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.44.1.10279",
              "templateHash": "7171542896075827119"
            }
          },
          "parameters": {
            "location": {
              "type": "string",
              "metadata": {
                "description": "Azure region for the identities."
              }
            },
            "identityNames": {
              "type": "array",
              "defaultValue": [],
              "metadata": {
                "description": "Identity names to create."
              }
            }
          },
          "resources": [
            {
              "copy": {
                "name": "identities",
                "count": "[length(parameters('identityNames'))]"
              },
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
              "apiVersion": "2023-01-31",
              "name": "[parameters('identityNames')[copyIndex()]]",
              "location": "[parameters('location')]"
            }
          ],
          "outputs": {
            "identityResourceIds": {
              "type": "array",
              "copy": {
                "count": "[length(parameters('identityNames'))]",
                "input": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityNames')[copyIndex()])]"
              }
            },
            "identityPrincipalIds": {
              "type": "array",
              "copy": {
                "count": "[length(parameters('identityNames'))]",
                "input": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityNames')[copyIndex()]), '2023-01-31').principalId]"
              }
            },
            "identityNames": {
              "type": "array",
              "value": "[parameters('identityNames')]"
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "apimName": {
      "type": "string",
      "value": "[parameters('apimName')]"
    },
    "apimGatewayUrl": {
      "type": "string",
      "value": "[format('https://{0}.azure-api.net', parameters('apimName'))]"
    },
    "managedEnvironmentId": {
      "type": "string",
      "value": "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppsEnvironmentName'))]"
    },
    "managedEnvironmentName": {
      "type": "string",
      "value": "[parameters('containerAppsEnvironmentName')]"
    },
    "appInsightsConnectionString": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'monitoring'), '2025-04-01').outputs.appInsightsConnectionString.value]"
    },
    "logAnalyticsWorkspaceId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'monitoring'), '2025-04-01').outputs.workspaceId.value]"
    },
    "aiServicesName": {
      "type": "string",
      "value": "[parameters('aiServicesName')]"
    },
    "aiServicesEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', parameters('aiServicesName')), '2025-06-01').endpoint]"
    },
    "aiProjectName": {
      "type": "string",
      "value": "[if(parameters('createFoundryProject'), parameters('aiProjectName'), '')]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[parameters('keyVaultName')]"
    },
    "keyVaultResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]"
    },
    "scenarioIdentityResourceIds": {
      "type": "array",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'scenario-identities'), '2025-04-01').outputs.identityResourceIds.value]"
    },
    "scenarioIdentityNames": {
      "type": "array",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'scenario-identities'), '2025-04-01').outputs.identityNames.value]"
    },
    "scenarioIdentityPrincipalIds": {
      "type": "array",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'scenario-identities'), '2025-04-01').outputs.identityPrincipalIds.value]"
    }
  }
}