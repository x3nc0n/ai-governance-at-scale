{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "16552644393374957930"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the scenario deployment."
      }
    },
    "appName": {
      "type": "string",
      "defaultValue": "[format('ca-endpoint-ai-{0}', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Name of the scenario container app."
      }
    },
    "foundationResourceGroupName": {
      "type": "string",
      "defaultValue": "rg-aigov-foundation-demo",
      "metadata": {
        "description": "Name of the foundation resource group that contains the shared governance estate."
      }
    },
    "foundationSubscriptionId": {
      "type": "string",
      "defaultValue": "[subscription().subscriptionId]",
      "metadata": {
        "description": "Subscription ID that contains the foundation deployment. Defaults to the current subscription."
      }
    },
    "containerImageName": {
      "type": "string",
      "defaultValue": "aigov-demo-app:latest",
      "metadata": {
        "description": "Name of the shared demo image to deploy for this scenario."
      }
    },
    "foundationApimUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Gateway URL for the shared API Management instance. Leave blank to use the derived foundation APIM endpoint."
      }
    },
    "foundationManagedEnvironmentName": {
      "type": "string",
      "metadata": {
        "description": "Name of the shared managed environment in the foundation resource group."
      }
    },
    "foundationContainerRegistryName": {
      "type": "string",
      "metadata": {
        "description": "Name of the shared container registry in the foundation resource group."
      }
    },
    "foundationApimName": {
      "type": "string",
      "metadata": {
        "description": "Name of the shared API Management instance in the foundation resource group."
      }
    },
    "foundationAiServicesName": {
      "type": "string",
      "metadata": {
        "description": "Name of the shared Azure AI Services account in the foundation resource group."
      }
    }
  },
  "variables": {
    "foundationIdentityName": "id-scenario-01",
    "resolvedFoundationApimUrl": "[if(empty(parameters('foundationApimUrl')), format('https://{0}.azure-api.net', parameters('foundationApimName')), parameters('foundationApimUrl'))]"
  },
  "resources": {
    "managedEnvironment": {
      "existing": true,
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "subscriptionId": "[parameters('foundationSubscriptionId')]",
      "resourceGroup": "[parameters('foundationResourceGroupName')]",
      "name": "[parameters('foundationManagedEnvironmentName')]"
    },
    "scenarioIdentity": {
      "existing": true,
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "subscriptionId": "[parameters('foundationSubscriptionId')]",
      "resourceGroup": "[parameters('foundationResourceGroupName')]",
      "name": "[variables('foundationIdentityName')]"
    },
    "containerRegistry": {
      "existing": true,
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-07-01",
      "subscriptionId": "[parameters('foundationSubscriptionId')]",
      "resourceGroup": "[parameters('foundationResourceGroupName')]",
      "name": "[parameters('foundationContainerRegistryName')]"
    },
    "containerApp": {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', parameters('foundationSubscriptionId'), parameters('foundationResourceGroupName')), 'Microsoft.ManagedIdentity/userAssignedIdentities', variables('foundationIdentityName')))]": {}
        }
      },
      "properties": {
        "managedEnvironmentId": "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', parameters('foundationSubscriptionId'), parameters('foundationResourceGroupName')), 'Microsoft.App/managedEnvironments', parameters('foundationManagedEnvironmentName'))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "allowInsecure": false
          },
          "secrets": [
            {
              "name": "acr-password",
              "value": "[listCredentials('containerRegistry', '2023-07-01').passwords[0].value]"
            }
          ],
          "registries": [
            {
              "server": "[reference('containerRegistry').loginServer]",
              "username": "[listCredentials('containerRegistry', '2023-07-01').username]",
              "passwordSecretRef": "acr-password"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "endpoint-ai",
              "image": "[format('{0}/{1}', reference('containerRegistry').loginServer, parameters('containerImageName'))]",
              "env": [
                {
                  "name": "SCENARIO_ID",
                  "value": "01-endpoint-ai"
                },
                {
                  "name": "APIM_ENDPOINT",
                  "value": "[variables('resolvedFoundationApimUrl')]"
                },
                {
                  "name": "AZURE_AI_SERVICES",
                  "value": "[parameters('foundationAiServicesName')]"
                },
                {
                  "name": "AZURE_CLIENT_ID",
                  "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', parameters('foundationSubscriptionId'), parameters('foundationResourceGroupName')), 'Microsoft.ManagedIdentity/userAssignedIdentities', variables('foundationIdentityName')), '2023-01-31').clientId]"
                },
                {
                  "name": "SCENARIO_LABEL",
                  "value": "Developer Governance Assistant"
                },
                {
                  "name": "SCENARIO_DESCRIPTION",
                  "value": "A developer-focused governance assistant that answers approved-tool and policy questions"
                }
              ],
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              }
            }
          ]
        }
      },
      "dependsOn": [
        "containerRegistry"
      ]
    },
    "developerKnowledgeApim": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "developerKnowledgeApim",
      "subscriptionId": "[parameters('foundationSubscriptionId')]",
      "resourceGroup": "[parameters('foundationResourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "apimName": {
            "value": "[parameters('foundationApimName')]"
          },
          "containerAppFqdn": {
            "value": "[reference('containerApp').configuration.ingress.fqdn]"
          },
          "apiName": {
            "value": "developer-knowledge-base"
          },
          "apiPath": {
            "value": "developer-kb"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.44.1.10279",
              "templateHash": "12414203181257859430"
            }
          },
          "parameters": {
            "apimName": {
              "type": "string",
              "metadata": {
                "description": "Name of the shared APIM instance in the foundation resource group."
              }
            },
            "containerAppFqdn": {
              "type": "string",
              "metadata": {
                "description": "Fully qualified domain name of the developer knowledge base container app."
              }
            },
            "apiName": {
              "type": "string",
              "defaultValue": "developer-knowledge-base",
              "metadata": {
                "description": "Name of the APIM API to create."
              }
            },
            "apiPath": {
              "type": "string",
              "defaultValue": "developer-kb",
              "metadata": {
                "description": "Path for the APIM API."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.ApiManagement/service/apis",
              "apiVersion": "2022-08-01",
              "name": "[format('{0}/{1}', parameters('apimName'), parameters('apiName'))]",
              "properties": {
                "displayName": "Developer Knowledge Base",
                "path": "[parameters('apiPath')]",
                "protocols": [
                  "https"
                ],
                "serviceUrl": "[format('https://{0}', parameters('containerAppFqdn'))]",
                "subscriptionRequired": true,
                "type": "http"
              }
            },
            {
              "type": "Microsoft.ApiManagement/service/apis/operations",
              "apiVersion": "2022-08-01",
              "name": "[format('{0}/{1}/{2}', parameters('apimName'), parameters('apiName'), 'invoke')]",
              "properties": {
                "displayName": "Invoke developer knowledge base",
                "method": "POST",
                "urlTemplate": "/invoke",
                "responses": [
                  {
                    "statusCode": 200,
                    "description": "Knowledge response"
                  }
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.ApiManagement/service/apis', parameters('apimName'), parameters('apiName'))]"
              ]
            }
          ]
        }
      },
      "dependsOn": [
        "containerApp"
      ]
    }
  },
  "outputs": {
    "containerAppName": {
      "type": "string",
      "value": "[parameters('appName')]"
    },
    "containerAppFqdn": {
      "type": "string",
      "value": "[reference('containerApp').configuration.ingress.fqdn]"
    },
    "identityPrincipalId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', parameters('foundationSubscriptionId'), parameters('foundationResourceGroupName')), 'Microsoft.ManagedIdentity/userAssignedIdentities', variables('foundationIdentityName')), '2023-01-31').principalId]"
    }
  }
}