{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "2126982772989143018"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the scenario deployment."
      }
    },
    "appName": {
      "type": "string",
      "defaultValue": "[format('ca-copilot-studio-{0}', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Name of the scenario container app."
      }
    },
    "managedEnvironmentId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the shared managed environment."
      }
    },
    "identityResourceId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the user-assigned identity for this scenario."
      }
    },
    "identityClientId": {
      "type": "string",
      "metadata": {
        "description": "Client ID of the user-assigned identity for this scenario."
      }
    },
    "containerRegistryServer": {
      "type": "string",
      "metadata": {
        "description": "Registry server for the shared demo image."
      }
    },
    "containerRegistryUsername": {
      "type": "string",
      "metadata": {
        "description": "Registry username for the shared demo image."
      }
    },
    "containerRegistryPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Registry password for the shared demo image."
      }
    },
    "containerImageName": {
      "type": "string",
      "defaultValue": "aigov-demo-app:latest",
      "metadata": {
        "description": "Name of the shared demo image to deploy for this scenario."
      }
    },
    "foundationAiServicesName": {
      "type": "string",
      "defaultValue": "ai-services",
      "metadata": {
        "description": "Name of the shared Azure AI Services account."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', parameters('identityResourceId'))]": {}
        }
      },
      "properties": {
        "managedEnvironmentId": "[parameters('managedEnvironmentId')]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "allowInsecure": false
          },
          "secrets": [
            {
              "name": "acr-password",
              "value": "[parameters('containerRegistryPassword')]"
            }
          ],
          "registries": [
            {
              "server": "[parameters('containerRegistryServer')]",
              "username": "[parameters('containerRegistryUsername')]",
              "passwordSecretRef": "acr-password"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "copilot-studio",
              "image": "[format('{0}/{1}', parameters('containerRegistryServer'), parameters('containerImageName'))]",
              "env": [
                {
                  "name": "SCENARIO_ID",
                  "value": "03-copilot-studio"
                },
                {
                  "name": "AZURE_AI_SERVICES",
                  "value": "[parameters('foundationAiServicesName')]"
                },
                {
                  "name": "AZURE_CLIENT_ID",
                  "value": "[parameters('identityClientId')]"
                },
                {
                  "name": "SCENARIO_LABEL",
                  "value": "Copilot Studio Agent"
                },
                {
                  "name": "SCENARIO_DESCRIPTION",
                  "value": "A low-code Copilot Studio agent with governed backend routing"
                }
              ],
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              }
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "containerAppName": {
      "type": "string",
      "value": "[parameters('appName')]"
    },
    "containerAppFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('appName')), '2024-03-01').configuration.ingress.fqdn]"
    },
    "identityPrincipalId": {
      "type": "string",
      "value": "[reference(parameters('identityResourceId'), '2023-01-31').principalId]"
    }
  }
}