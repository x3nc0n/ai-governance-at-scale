{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "3765794038604668634"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the scenario deployment."
      }
    },
    "appName": {
      "type": "string",
      "defaultValue": "[format('ca-copilot-studio-{0}', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Name of the scenario container app."
      }
    },
    "foundationResourceGroupName": {
      "type": "string",
      "defaultValue": "rg-aigov-foundation-demo",
      "metadata": {
        "description": "Name of the foundation resource group that contains the shared governance estate."
      }
    },
    "foundationSubscriptionId": {
      "type": "string",
      "defaultValue": "[subscription().subscriptionId]",
      "metadata": {
        "description": "Subscription ID that contains the foundation deployment. Defaults to the current subscription."
      }
    },
    "containerImageName": {
      "type": "string",
      "defaultValue": "aigov-demo-app:latest",
      "metadata": {
        "description": "Name of the shared demo image to deploy for this scenario."
      }
    },
    "foundationManagedEnvironmentName": {
      "type": "string",
      "metadata": {
        "description": "Name of the shared managed environment in the foundation resource group."
      }
    },
    "foundationContainerRegistryName": {
      "type": "string",
      "metadata": {
        "description": "Name of the shared container registry in the foundation resource group."
      }
    },
    "foundationAiServicesName": {
      "type": "string",
      "metadata": {
        "description": "Name of the shared Azure AI Services account in the foundation resource group."
      }
    },
    "foundationApimName": {
      "type": "string",
      "metadata": {
        "description": "Name of the shared API Management instance in the foundation resource group."
      }
    },
    "foundationApimSubscriptionKey": {
      "type": "securestring",
      "metadata": {
        "description": "APIM subscription key authorized for the developer knowledge base API. Supply securely at deployment time."
      }
    }
  },
  "variables": {
    "foundationIdentityName": "id-scenario-03"
  },
  "resources": {
    "managedEnvironment": {
      "existing": true,
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "subscriptionId": "[parameters('foundationSubscriptionId')]",
      "resourceGroup": "[parameters('foundationResourceGroupName')]",
      "name": "[parameters('foundationManagedEnvironmentName')]"
    },
    "scenarioIdentity": {
      "existing": true,
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "subscriptionId": "[parameters('foundationSubscriptionId')]",
      "resourceGroup": "[parameters('foundationResourceGroupName')]",
      "name": "[variables('foundationIdentityName')]"
    },
    "containerRegistry": {
      "existing": true,
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-07-01",
      "subscriptionId": "[parameters('foundationSubscriptionId')]",
      "resourceGroup": "[parameters('foundationResourceGroupName')]",
      "name": "[parameters('foundationContainerRegistryName')]"
    },
    "containerApp": {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', parameters('foundationSubscriptionId'), parameters('foundationResourceGroupName')), 'Microsoft.ManagedIdentity/userAssignedIdentities', variables('foundationIdentityName')))]": {}
        }
      },
      "properties": {
        "managedEnvironmentId": "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', parameters('foundationSubscriptionId'), parameters('foundationResourceGroupName')), 'Microsoft.App/managedEnvironments', parameters('foundationManagedEnvironmentName'))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "allowInsecure": false
          },
          "secrets": [
            {
              "name": "apim-subscription-key",
              "value": "[parameters('foundationApimSubscriptionKey')]"
            },
            {
              "name": "acr-password",
              "value": "[listCredentials('containerRegistry', '2023-07-01').passwords[0].value]"
            }
          ],
          "registries": [
            {
              "server": "[reference('containerRegistry').loginServer]",
              "username": "[listCredentials('containerRegistry', '2023-07-01').username]",
              "passwordSecretRef": "acr-password"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "copilot-studio",
              "image": "[format('{0}/{1}', reference('containerRegistry').loginServer, parameters('containerImageName'))]",
              "env": [
                {
                  "name": "SCENARIO_ID",
                  "value": "03-copilot-studio"
                },
                {
                  "name": "AZURE_AI_SERVICES",
                  "value": "[parameters('foundationAiServicesName')]"
                },
                {
                  "name": "AZURE_CLIENT_ID",
                  "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', parameters('foundationSubscriptionId'), parameters('foundationResourceGroupName')), 'Microsoft.ManagedIdentity/userAssignedIdentities', variables('foundationIdentityName')), '2023-01-31').clientId]"
                },
                {
                  "name": "SCENARIO_LABEL",
                  "value": "Copilot Studio Governance Agent"
                },
                {
                  "name": "SCENARIO_DESCRIPTION",
                  "value": "A low-code governance agent that brokers requests to the developer knowledge base behind APIM"
                },
                {
                  "name": "KNOWLEDGE_BASE_URL",
                  "value": "[format('https://{0}.azure-api.net/developer-kb/invoke', parameters('foundationApimName'))]"
                },
                {
                  "name": "APIM_SUBSCRIPTION_KEY",
                  "secretRef": "apim-subscription-key"
                }
              ],
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              }
            }
          ]
        }
      },
      "dependsOn": [
        "containerRegistry"
      ]
    }
  },
  "outputs": {
    "containerAppName": {
      "type": "string",
      "value": "[parameters('appName')]"
    },
    "containerAppFqdn": {
      "type": "string",
      "value": "[reference('containerApp').configuration.ingress.fqdn]"
    },
    "identityPrincipalId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', parameters('foundationSubscriptionId'), parameters('foundationResourceGroupName')), 'Microsoft.ManagedIdentity/userAssignedIdentities', variables('foundationIdentityName')), '2023-01-31').principalId]"
    }
  }
}